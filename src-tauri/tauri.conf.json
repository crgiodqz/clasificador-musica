{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clasificador de musica",
  "version": "0.4.0",
  "identifier": "ar.sergio.clasificador",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [ { "title": "Clasificador de música", "width": 1280, "height": 800, "maximized": true, "minWidth": 900, "minHeight": 600, "zoomHotkeysEnabled": false, "backgroundColor": "#1c1c1e" } ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
